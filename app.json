{
  "expo": {
    "name": "Travelling App",
    "slug": "travelling-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "usesCleartextTraffic": true
    },
    "web": {},
    "plugins": [
      "expo-secure-store"
    ]
  }
}
